# ── ListingLens local environment ─────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values. docker-compose reads
# this file via `env_file:`. Render production reads its own copy from the
# dashboard — keep that in sync when you add new keys.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Groq hosts every generation model. Required for /agent/query,
# /assistant/query (copilot + quick), /chat, /brief, /intent/classify, and
# the review_qa tool. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face — used by the ingest layer (review fetch). NOT needed for
# retrieval: embeddings run locally via sentence-transformers on CPU.
# Required only when running the heavy NLP pipeline in dev mode —
# production reads from precomputed CSVs.
HUGGINGFACE_API_KEY=

# Alternate HF token name read by src/nlp_pipeline.py. Set whichever the
# pipeline you are running expects; both are dev-mode only.
HF_TOKEN=

# RapidAPI key for live Amazon review fetching (src/ingest.py). Only needed
# to ingest a NEW ASIN; the 12 shipped ASINs are precomputed.
RAPIDAPI_KEY=

# ── Tracing (optional) ────────────────────────────────────────────────────────
# Leave blank/false in shared envs to avoid leaking traces. eval/run_eval
# flips override=True locally so your shell key isn't blocked.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=listinglens-copilot

# ── Model pins ────────────────────────────────────────────────────────────────
# Defaults live in src/llm_config.py; these override them. Groq rate-limits
# PER MODEL (8000 TPM each), so the split below is deliberate load balancing,
# not just quality tiering — three hot paths get three independent buckets:
#
#   AGENT_MODEL     planner + synthesizer + brief   bucket A
#   EXECUTOR_MODEL  executor tool-selection loop    bucket B
#   GROQ_MODEL      review_qa RAG + /chat           bucket C
#
# GROQ_MODEL must NOT match AGENT_MODEL: the executor calls review_qa mid-run,
# so sharing makes a single agent run rate-limit itself.
#
# You do NOT have to keep these current for the app to stay up. Each stage has
# an ordered fallback chain in src/llm_config.py; if the pinned model is
# decommissioned (404) or rate-limited (429), the call transparently fails over
# to the next live model and logs what happened. A stage only breaks if EVERY
# model in its chain is gone.
#
# Only four free Groq models support both tool-calling and structured output:
#   openai/gpt-oss-120b, openai/gpt-oss-20b,
#   openai/gpt-oss-safeguard-20b, qwen/qwen3.8-27b
# (allam-2-7b and groq/compound* reject `tools` outright.)
#
# After changing anything here, run:
#   python -m scripts.doctor
AGENT_MODEL=openai/gpt-oss-120b
EXECUTOR_MODEL=openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b
# Intent-classification LLM fallback. Shares bucket B on purpose — it fires
# only below the sklearn confidence threshold and never inside a copilot run.
INTENT_LLM_MODEL=openai/gpt-oss-20b

# ── Intent classifier ─────────────────────────────────────────────────────────
# sklearn predicts first; below this confidence the LLM fallback runs.
# INTENT_CONFIDENCE_THRESHOLD=0.55

# ── Eval judge ────────────────────────────────────────────────────────────────
# LLM-as-judge for eval/run_eval.py. Kept in a DIFFERENT model family from the
# agent so it isn't grading its own homework. `anthropic` (default) needs
# ANTHROPIC_API_KEY; `openai` needs OPENAI_API_KEY. Run with --no-judge to
# skip judging and need neither.
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# JUDGE_MODEL_OPENAI=gpt-4o-mini
ANTHROPIC_API_KEY=

# ── Runtime mode ──────────────────────────────────────────────────────────────
# `production` — only serve ASINs with on-disk precomputed caches, 404 others.
# `development` — fall back to live NLP pipeline for missing ASINs (slow).
ENV_MODE=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. The defaults baked into app.py cover Vercel
# previews + localhost:3000 — override here only if you're hosting the
# frontend somewhere new.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-host.example.com

# ── Cache ─────────────────────────────────────────────────────────────────────
# Service name `redis` matches the docker-compose service. If you run
# the backend without compose, leave unset and backend/cache.py becomes
# a passthrough (every agent call recomputes).
REDIS_URL=redis://redis:6379

# Agent result cache TTL in seconds. 1h is a safe default — agent traces
# referencing reviews don't go stale within a session.
AGENT_CACHE_TTL=3600
