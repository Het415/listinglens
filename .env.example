# ── ListingLens local environment ─────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values. docker-compose reads
# this file via `env_file:`. Render production reads its own copy from the
# dashboard — keep that in sync when you add new keys.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Groq hosts the agent model (Llama 3.3 70B by default). Required for
# /agent/query, /assistant/query (copilot), /chat, and the quick path's
# review_qa tool.
GROQ_API_KEY=

# Hugging Face Inference API used by the ingest layer (review fetch) and
# some embeddings. Required only when running the heavy NLP pipeline in
# dev mode — production reads from precomputed CSVs.
HUGGINGFACE_API_KEY=

# ── Tracing (optional) ────────────────────────────────────────────────────────
# Leave blank/false in shared envs to avoid leaking traces. eval/run_eval
# flips override=True locally so your shell key isn't blocked.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=listinglens-copilot

# ── Agent config ──────────────────────────────────────────────────────────────
# Pin the Groq model. Override only if Groq deprecates the default.
AGENT_MODEL=llama-3.3-70b-versatile
# Executor runs on a smaller/faster model on its own Groq daily bucket so the
# multi-step tool-selection calls don't burn the planner/synthesizer budget.
EXECUTOR_MODEL=llama-3.1-8b-instant

# ── Runtime mode ──────────────────────────────────────────────────────────────
# `production` — only serve ASINs with on-disk precomputed caches, 404 others.
# `development` — fall back to live NLP pipeline for missing ASINs (slow).
ENV_MODE=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. The defaults baked into app.py cover Vercel
# previews + localhost:3000 — override here only if you're hosting the
# frontend somewhere new.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-host.example.com

# ── Cache ─────────────────────────────────────────────────────────────────────
# Service name `redis` matches the docker-compose service. If you run
# the backend without compose, leave unset and backend/cache.py becomes
# a passthrough (every agent call recomputes).
REDIS_URL=redis://redis:6379

# Agent result cache TTL in seconds. 1h is a safe default — agent traces
# referencing reviews don't go stale within a session.
AGENT_CACHE_TTL=3600
