# Names only; never commit real values. Production values live in Vercel.
#
# Local secrets go in frontend/.env.development.local, NOT .env.local:
# .env.local is tracked in this repo (committed before it was gitignored), so
# anything written there is one `git commit -a` away from being published.
# `npm run dev` and `npm run db:migrate` both read .env.development.local.

# ── Backend ──────────────────────────────────────────────────────────────────
# Render public URL, no trailing slash.
NEXT_PUBLIC_API_URL=https://listinglens-api.onrender.com
# direct (default): the browser calls NEXT_PUBLIC_API_URL.
# proxy: the browser calls /api/backend/*, which adds BACKEND_SHARED_SECRET.
# Switch to proxy only in the order in docs/INTERNAL_AUTH.md.
NEXT_PUBLIC_API_MODE=direct
# Server-only. The proxy uses BACKEND_URL, falling back to NEXT_PUBLIC_API_URL.
BACKEND_URL=
BACKEND_SHARED_SECRET=

# Image audit service (vislens) and the live-agent toggle for /agent.
NEXT_PUBLIC_VISLENS_URL=
NEXT_PUBLIC_AGENT_LIVE=

# ── Accounts (Better Auth + Neon) ────────────────────────────────────────────
# Pooled connection string (the app) and direct one (migrations only).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; https://listinglens.hetprajapati.me in production.
BETTER_AUTH_URL=http://localhost:3000
# Google: one OAuth client with both callback URLs:
#   http://localhost:3000/api/auth/callback/google
#   https://listinglens.hetprajapati.me/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: a separate OAuth app per environment (GitHub allows one callback each).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tests only: a throwaway Postgres (never production). See tests/api-me.test.ts.
TEST_DATABASE_URL=
