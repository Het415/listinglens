# DuckDB analytical warehouse — rebuildable from the source files via
# `python -m scripts.build_duckdb`. Kept out of git to avoid binary bloat and
# stale-data risk (the loader falls back to the authoritative files when absent).
data/processed/*.duckdb
data/processed/*.duckdb.wal

.agents/
.deepeval/

# Claude Code internal state — worktrees, plan files, agent scratch.
# Should never enter git history.
.claude/worktrees/

# TypeScript incremental compilation cache — regenerated on every
# `next build`, churns on every push.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Pytest + tooling caches
.pytest_cache/

# Personal launch artifacts — kept locally but not in the public repo
docs/LOOM_SCRIPT.md
docs/LINKEDIN_POST.md